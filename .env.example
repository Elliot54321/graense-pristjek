# Copy to .env.local and fill in.

# Shown to shops in the scraper User-Agent so they can contact us.
SCRAPER_CONTACT_EMAIL=

# Supabase: Project Settings -> API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) - safe for the browser, read-only via RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) - server/scrapers only, bypasses RLS. Never expose it.
SUPABASE_SECRET_KEY=
